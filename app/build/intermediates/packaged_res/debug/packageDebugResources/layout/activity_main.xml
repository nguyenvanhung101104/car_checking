<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_blue"
        app:title="@string/app_name"
        app:titleTextColor="@color/white">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_fuel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:padding="4dp"
                android:src="@drawable/ic_fuel"
                app:tint="@color/white"
                android:contentDescription="Fuel status" />

            <ImageView
                android:id="@+id/iv_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:padding="4dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/white"
                android:contentDescription="Settings" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btn_disconnect"
        android:layout_below="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_ecu_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ecu_id_label"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/text_grey" />

            <!-- Dashboard Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="3">

                <include layout="@layout/dashboard_item" android:id="@+id/item_dashboard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                <include layout="@layout/dashboard_item" android:id="@+id/item_live_data" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                <include layout="@layout/dashboard_item" android:id="@+id/item_sensors" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />

                <include layout="@layout/dashboard_item" android:id="@+id/item_dtc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                <include layout="@layout/dashboard_item" android:id="@+id/item_freeze_frame" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                <include layout="@layout/dashboard_item" android:id="@+id/item_monitors" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />

                <include layout="@layout/dashboard_item" android:id="@+id/item_acceleration" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                <include layout="@layout/dashboard_item" android:id="@+id/item_emission" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                <include layout="@layout/dashboard_item" android:id="@+id/item_terminal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />

            </GridLayout>

            <!-- Details Section -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:stretchColumns="1">

                <TableRow android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protocol_label"
                        android:textColor="@color/text_grey"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tv_protocol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/mock_protocol"
                        android:textColor="@color/text_grey"
                        android:textSize="13sp" />
                </TableRow>

                <TableRow android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vin_label"
                        android:textColor="@color/text_grey"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tv_vin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/mock_vin"
                        android:textColor="@color/text_grey"
                        android:textSize="13sp" />
                </TableRow>

                <TableRow android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calibration_id_label"
                        android:textColor="@color/text_grey"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tv_calibration_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/mock_calibration_id"
                        android:textColor="@color/text_grey"
                        android:textSize="13sp" />
                </TableRow>
            </TableLayout>

            <!-- Connection Status -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:stretchColumns="1">

                <TableRow android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/elm_connection"
                        android:textColor="@color/text_grey"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tv_elm_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/status_connected"
                        android:textColor="@color/status_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ecu_connection"
                        android:textColor="@color/text_grey"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tv_ecu_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/status_connected"
                        android:textColor="@color/status_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </TableRow>
            </TableLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_disconnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:backgroundTint="@color/disconnect_red"
        android:text="@string/btn_disconnect"
        android:textColor="@color/white"
        app:cornerRadius="0dp" />

</RelativeLayout>
